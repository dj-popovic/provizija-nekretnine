# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# XML feed (required)
XML_FEED_URL=https://your-relper-feed-url-here

# XML refresh interval in milliseconds (default: 3600000 = 1 hour)
XML_REFRESH_INTERVAL_MS=3600000

# CORS — leave empty (default): the frontend is served from the same origin and
# needs no CORS. Only set comma-separated origins if a separate frontend domain
# must call the API. Never use * in production (any site could submit our forms).
# CORS_ORIGIN=

# Proxy — true when the app runs behind a hosting proxy (Render etc.), so each
# visitor's real IP is used for rate limiting. Use false only if exposed directly.
# TRUST_PROXY=true

# Rate limiting (per visitor IP; /api routes only — static files are never limited)
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_FORMS_MAX=5
# RATE_LIMIT_FORMS_WINDOW_MS=60000

# Email (Resend)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@yourdomain.com
AGENCY_EMAIL=pro.vizijanekretnine@gmail.com

# Development only — enable manual sync trigger endpoint
MANUAL_REFRESH_ENABLED=false
